{
  "format": {
    "name": "graph-universe",
    "version": "1.0"
  },
  "meta": {
    "title": "Nested universe reference",
    "description": "A deterministic five-level graph for validating generic spatial visualization."
  },
  "nodeTypes": [
    { "id": "galaxy", "label": "Galaxy", "visualRole": "universe-container", "baseSize": 4, "visualToken": "galaxy" },
    { "id": "system", "label": "System", "visualRole": "system-container", "baseSize": 3, "visualToken": "system" },
    { "id": "star", "label": "Star", "visualRole": "central-body", "baseSize": 2.4, "visualToken": "star" },
    { "id": "planet", "label": "Planet", "visualRole": "orbiting-body", "baseSize": 1.5, "visualToken": "planet" },
    { "id": "moon", "label": "Moon", "visualRole": "satellite", "baseSize": 0.8, "visualToken": "moon" }
  ],
  "linkTypes": [
    { "id": "contains", "label": "Contains", "role": "containment", "visualToken": "containment" },
    { "id": "references", "label": "References", "role": "relation", "visualToken": "reference" },
    { "id": "summary-reference", "label": "Summary reference", "role": "summary", "visualToken": "summary" }
  ],
  "metricDefinitions": {
    "mass": {
      "label": "Mass",
      "unit": "relative",
      "valueType": "number",
      "description": "Relative node importance for size mapping."
    },
    "complexity": {
      "label": "Complexity",
      "unit": "score",
      "valueType": "number",
      "description": "A second named node metric for profile and selector checks."
    },
    "dependencyCount": {
      "label": "Connection count",
      "unit": "links",
      "valueType": "number",
      "description": "Named link metric used by the overview profile."
    },
    "referenceStrength": {
      "label": "Reference strength",
      "unit": "score",
      "valueType": "number",
      "description": "Named link metric used by the detail profile."
    }
  },
  "viewProfiles": [
    {
      "id": "nested-overview",
      "label": "Universe overview",
      "detailLevel": 0,
      "visibleNodeTypes": ["galaxy", "system", "star"],
      "visibleLinkTypes": ["contains", "summary-reference"],
      "nodeMetric": "mass",
      "linkMetric": "dependencyCount",
      "layoutProfileId": "nested-overview"
    },
    {
      "id": "nested-detail",
      "label": "Universe detail",
      "detailLevel": 1,
      "visibleNodeTypes": ["galaxy", "system", "star", "planet", "moon"],
      "visibleLinkTypes": ["contains", "references", "summary-reference"],
      "nodeMetric": "complexity",
      "linkMetric": "referenceStrength",
      "layoutProfileId": "nested-detail"
    }
  ],
  "layoutProfiles": [
    {
      "id": "nested-overview",
      "label": "Overview spacing",
      "groupField": "groupId",
      "groupDistance": 140,
      "defaultDistance": 42,
      "containmentDistances": [
        { "parentTypeId": "galaxy", "childTypeId": "system", "distance": 100 },
        { "parentTypeId": "system", "childTypeId": "star", "distance": 70 },
        { "parentTypeId": "star", "childTypeId": "planet", "distance": 44 },
        { "parentTypeId": "planet", "childTypeId": "moon", "distance": 22 }
      ]
    },
    {
      "id": "nested-detail",
      "label": "Detail spacing",
      "groupField": "groupId",
      "groupDistance": 180,
      "defaultDistance": 32,
      "containmentDistances": [
        { "parentTypeId": "galaxy", "childTypeId": "system", "distance": 110 },
        { "parentTypeId": "system", "childTypeId": "star", "distance": 78 },
        { "parentTypeId": "star", "childTypeId": "planet", "distance": 48 },
        { "parentTypeId": "planet", "childTypeId": "moon", "distance": 24 }
      ]
    }
  ],
  "containmentRules": [
    { "id": "galaxy-contains-system", "linkTypeId": "contains", "parentTypeId": "galaxy", "childTypeId": "system", "maxParents": 1, "acyclic": true },
    { "id": "system-contains-star", "linkTypeId": "contains", "parentTypeId": "system", "childTypeId": "star", "maxParents": 1, "acyclic": true },
    { "id": "star-contains-planet", "linkTypeId": "contains", "parentTypeId": "star", "childTypeId": "planet", "maxParents": 1, "acyclic": true },
    { "id": "planet-contains-moon", "linkTypeId": "contains", "parentTypeId": "planet", "childTypeId": "moon", "maxParents": 1, "acyclic": true }
  ],
  "hierarchy": {
    "containmentLinkTypes": ["contains"],
    "maxParents": 1,
    "acyclic": true
  },
  "visualTokens": {
    "galaxy": { "kind": "node", "color": "#a78bfa", "shape": "icosahedron" },
    "system": { "kind": "node", "color": "#60a5fa", "shape": "dodecahedron" },
    "star": { "kind": "node", "color": "#fbbf24", "shape": "sphere" },
    "planet": { "kind": "node", "color": "#34d399", "shape": "sphere" },
    "moon": { "kind": "node", "color": "#cbd5e1", "shape": "tetrahedron" },
    "containment": { "kind": "link", "color": "#64748b", "lineStyle": "solid" },
    "reference": { "kind": "link", "color": "#f472b6", "lineStyle": "solid" },
    "summary": { "kind": "link", "color": "#fb923c", "lineStyle": "dashed" }
  },
  "theme": { "id": "nested-universe", "fallbackToken": "moon", "background": "#080b18" },
