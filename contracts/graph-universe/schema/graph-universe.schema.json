{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RalfHuesing/CodeVisualisierung/blob/main/contracts/graph-universe/schema/graph-universe.schema.json",
  "title": "Graph Universe",
  "description": "Source-independent graph data for the CodeVisualisierung viewer.",
  "type": "object",
  "required": ["format", "nodes", "links"],
  "properties": {
    "format": { "$ref": "#/$defs/format" },
    "meta": { "$ref": "#/$defs/meta" },
    "metricDefinitions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/metricDefinition" }
    },
    "nodeTypes": { "$ref": "#/$defs/definitions" },
    "linkTypes": { "$ref": "#/$defs/definitions" },
    "facets": { "type": "array", "items": { "$ref": "#/$defs/facet" } },
    "filterSources": { "type": "array", "items": { "$ref": "#/$defs/filterSource" } },
    "viewProfiles": { "type": "array", "items": { "$ref": "#/$defs/viewProfile" } },
    "layoutProfiles": { "type": "array", "items": { "$ref": "#/$defs/layoutProfile" } },
    "projections": { "type": "array", "items": { "$ref": "#/$defs/projection" } },
    "containmentRules": { "type": "array", "items": { "$ref": "#/$defs/containmentRule" } },
    "hierarchy": { "$ref": "#/$defs/hierarchy" },
    "visualTokens": { "type": "object", "additionalProperties": { "$ref": "#/$defs/visualToken" } },
    "theme": { "$ref": "#/$defs/theme" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
  },
  "additionalProperties": true,
  "$defs": {
    "format": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "graph-universe" },
        "version": { "const": "1.0" }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "source": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "metricDefinition": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "unit": { "type": "string" },
        "valueType": { "const": "number" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/typeDefinition" }
    },
    "typeDefinition": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "role": { "type": "string" },
        "visualToken": { "type": "string", "minLength": 1 },
        "visualRole": { "type": "string" },
        "baseSize": { "type": "number", "exclusiveMinimum": 0 },
        "directed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "facet": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["scope", "field"],
          "properties": {
            "scope": { "enum": ["node", "link", "graph"] },
            "field": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "filterSource": {
      "type": "object",
      "required": ["id", "facetId"],
      "properties": { "id": { "type": "string" }, "facetId": { "type": "string" }, "label": { "type": "string" } },
      "additionalProperties": true
    },
    "viewProfile": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "detailLevel": { "type": "integer", "minimum": 0 },
        "visibleNodeTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "visibleLinkTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "nodeMetric": { "type": "string" },
        "linkMetric": { "type": "string" },
        "layoutProfileId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "layoutProfile": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "groupField": { "type": "string", "minLength": 1, "default": "groupId" },
        "groupDistance": { "type": "number", "exclusiveMinimum": 0 },
        "defaultDistance": { "type": "number", "exclusiveMinimum": 0 },
        "containmentDistances": {
          "type": "array",
          "items": { "$ref": "#/$defs/containmentDistance" }
        }
      },
      "additionalProperties": true
    },
    "containmentDistance": {
      "type": "object",
      "required": ["parentTypeId", "childTypeId", "distance"],
      "properties": {
        "parentTypeId": { "type": "string", "minLength": 1 },
        "childTypeId": { "type": "string", "minLength": 1 },
        "distance": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "projection": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string" }, "fromProfile": { "type": "string" }, "toProfile": { "type": "string" }, "linkTypeId": { "type": "string" } },
      "additionalProperties": true
    },
    "containmentRule": {
      "type": "object",
      "required": ["id", "linkTypeId"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "linkTypeId": { "type": "string" }, "parentTypeId": { "type": "string" }, "childTypeId": { "type": "string" }, "maxParents": { "type": "integer", "minimum": 1 }, "acyclic": { "type": "boolean" } },
      "additionalProperties": true
    },
    "hierarchy": {
      "type": "object",
      "properties": { "containmentLinkTypes": { "type": "array", "items": { "type": "string" } }, "maxParents": { "type": "integer", "minimum": 1 }, "acyclic": { "type": "boolean" } },
      "additionalProperties": true
    },
    "visualToken": { "type": "object", "additionalProperties": true },
    "theme": {
      "type": "object",
      "properties": { "id": { "type": "string" }, "fallbackToken": { "type": "string" }, "background": { "type": "string" } },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "typeId": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "kind": { "type": "string" },
        "groupId": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
        "attributes": { "type": "object" }
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "typeId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "directed": { "type": "boolean" },
        "weight": { "type": "number" },
        "summary": { "oneOf": [{ "type": "boolean" }, { "type": "object" }] },
        "derivedFrom": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
        "attributes": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
